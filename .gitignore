# ROS: the modules and the rig's two workspaces, built into folders of their
# own under each of these, inside the stepit-macro container.
build
install
log
.cache

# CMake
compile_commands.json

# VSCode
.vscode

# Python
__pycache__
*.egg-info

# The pictures the camera downloads, see rig.yaml.
pictures

# The values of the rig's state that survive a restart, e.g. the counts of a
# stack: see state_file in the section stack_state of rig.yaml.
state

# pnpm's store of the packages of the web pages, which pnpm keeps at the root
# of the file system the pages are on: in the container, the mounted repo.
.pnpm-store
