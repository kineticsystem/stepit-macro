---
config:
  theme: base
  fontFamily: "Arial, Helvetica, sans-serif"
  flowchart:
    curve: basis
    padding: 12
    nodeSpacing: 46
    rankSpacing: 32
    subGraphTitleMargin:
      top: 4
      bottom: 10
  class:
    padding: 10
  themeVariables:
    lineColor: "#94a3b8"
    textColor: "#64748b"
    primaryColor: "#f1f5f9"
    primaryBorderColor: "#64748b"
    primaryTextColor: "#0f172a"
    secondaryColor: "#f1f5f9"
    secondaryBorderColor: "#64748b"
    secondaryTextColor: "#0f172a"
    tertiaryColor: "#f1f5f9"
    tertiaryBorderColor: "#64748b"
    tertiaryTextColor: "#0f172a"
    mainBkg: "#f1f5f9"
    nodeBorder: "#64748b"
    nodeTextColor: "#0f172a"
    classText: "#0f172a"
    clusterBkg: "transparent"
    clusterBorder: "#94a3b8"
    titleColor: "#64748b"
    edgeLabelBackground: "#ffffff"
  themeCSS: >
    svg, .label, .nodeLabel, .edgeLabel, foreignObject div { font-family: Arial, Helvetica, sans-serif; }
    .node rect, .node polygon, .node path {
      filter: drop-shadow(0 3px 6px rgba(15, 23, 42, 0.18));
    }
    .node rect { rx: 14px; ry: 14px; }
    .cluster rect { rx: 18px; ry: 18px; }
    .edgeLabel, .edgeLabel p, .edgeLabel span {
      background: #ffffff; color: #475569; border-radius: 999px;
    }
    .edgeLabel p { padding: 3px 10px; }
    .labelBkg { background: transparent !important; fill: none !important; }
---
flowchart TB
    UI(["<b>StepIt UI</b><br/>tablet, port 8070"])
    Editor(["<b>StepIt Editor</b><br/>port 8080"])

    subgraph Rig["RASPBERRY PI 5: ONE CONTAINER"]
        Commander{{"<b>StepIt Commander</b><br/>behavior trees"}}
        Plugin("<b>Rig's behaviors and objectives</b><br/>src/plugins")
        Motors("<b>StepIt Motors</b><br/>ros2_control")
        Freezer("<b>StepIt Freezer</b><br/>driver")
        Camera("<b>StepIt Camera</b><br/>libgphoto2")
    end

    Teensy("<b>Teensy</b><br/>stepper motors")
    Nano("<b>Freezer board</b><br/>Arduino Nano")
    DSLR("<b>Canon 5D Mark II</b>")

    Stacker("<b>StepIt Stacker</b><br/>develop, merge, quilt")
    Holo("<b>HoloPi</b><br/>Looking Glass Portrait")

    UI -- "objectives" --> Commander
    Editor -- "edits and runs" --> Commander
    Commander --- Plugin
    Plugin --> Motors
    Plugin --> Freezer
    Plugin --> Camera
    Motors -. "serial" .-> Teensy
    Freezer -. "serial" .-> Nano
    Nano -. "shutter jack" .-> DSLR
    Camera -. "USB" .-> DSLR
    Camera == "pictures, after the rig" ==> Stacker
    Stacker == "quilt" ==> Holo

    classDef human fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#881337
    classDef voice fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#134e4a
    classDef mind  fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#4c1d95
    classDef brain fill:#7c3aed,stroke:#5b21b6,stroke-width:2px,color:#ffffff
    classDef robot fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f
    classDef data  fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    classDef ext   fill:#f1f5f9,stroke:#64748b,stroke-width:2px,color:#0f172a

    class UI,Editor human
    class Commander brain
    class Plugin mind
    class Motors,Freezer,Camera voice
    class Teensy,Nano,DSLR robot
    class Stacker,Holo data

    style Rig fill:#8b5cf612,stroke:#8b5cf6,stroke-width:1.5px,stroke-dasharray:6 5,color:#7c3aed

    linkStyle 0,1,2,3,4,5 stroke:#8b5cf6,stroke-width:2px
    linkStyle 6,7,8,9 stroke:#f59e0b,stroke-width:2px
    linkStyle 10,11 stroke:#3b82f6,stroke-width:3px
