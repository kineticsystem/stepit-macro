---
config:
  theme: base
  fontFamily: "Arial, Helvetica, sans-serif"
  flowchart:
    curve: basis
    padding: 12
    nodeSpacing: 46
    rankSpacing: 32
    subGraphTitleMargin:
      top: 4
      bottom: 10
  class:
    padding: 10
  themeVariables:
    lineColor: "#94a3b8"
    textColor: "#64748b"
    primaryColor: "#f1f5f9"
    primaryBorderColor: "#64748b"
    primaryTextColor: "#0f172a"
    secondaryColor: "#f1f5f9"
    secondaryBorderColor: "#64748b"
    secondaryTextColor: "#0f172a"
    tertiaryColor: "#f1f5f9"
    tertiaryBorderColor: "#64748b"
    tertiaryTextColor: "#0f172a"
    mainBkg: "#f1f5f9"
    nodeBorder: "#64748b"
    nodeTextColor: "#0f172a"
    classText: "#0f172a"
    clusterBkg: "transparent"
    clusterBorder: "#94a3b8"
    titleColor: "#64748b"
    edgeLabelBackground: "#ffffff"
  themeCSS: >
    svg, .label, .nodeLabel, .edgeLabel, foreignObject div { font-family: Arial, Helvetica, sans-serif; }
    .node rect, .node polygon, .node path {
      filter: drop-shadow(0 3px 6px rgba(15, 23, 42, 0.18));
    }
    .node rect { rx: 14px; ry: 14px; }
    .cluster rect { rx: 18px; ry: 18px; }
    .edgeLabel, .edgeLabel p, .edgeLabel span {
      background: #ffffff; color: #475569; border-radius: 999px;
    }
    .edgeLabel p { padding: 3px 10px; }
    .labelBkg { background: transparent !important; fill: none !important; }
---
flowchart TB
    subgraph Inputs["PEOPLE"]
        Browser(["<b>StepIt UI</b><br/>in the browser"])
        Gamepad(["<b>Gamepad</b><br/>/dev/input/js0"])
    end

    subgraph Container["STEPIT-MACRO CONTAINER"]
        Bridge("<b>rosbridge</b><br/>port 9090")
        Teleop("<b>gamepad_teleop</b><br/>ui_teleop")
        Power("<b>power_off</b>")
        State[("<b>stack_state</b><br/>state/stack.yaml")]
        Objectives[("<b>stepit_objectives</b><br/>XML")]
        Commander{{"<b>stepit_server</b><br/>with stepit_behaviors"}}
        Motors("<b>StepIt Motors</b><br/>controller manager")
        Camera("<b>StepIt Camera</b>")
        Freezer("<b>StepIt Freezer</b>")
    end

    Gamepad ==> Teleop
    Browser ==> Bridge
    Bridge --> Teleop
    Bridge --> Power
    Bridge --> Commander
    Bridge -- "parameters" --> State
    Teleop -- "objectives" --> Commander
    Commander -- "parameters" --> State
    Objectives -. "loaded" .-> Commander
    Teleop -- "velocities" --> Motors
    Commander --> Motors
    Commander --> Camera
    Commander --> Freezer

    classDef human fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#881337
    classDef voice fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#134e4a
    classDef mind  fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#4c1d95
    classDef brain fill:#7c3aed,stroke:#5b21b6,stroke-width:2px,color:#ffffff
    classDef robot fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f
    classDef data  fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    classDef ext   fill:#f1f5f9,stroke:#64748b,stroke-width:2px,color:#0f172a

    class Browser,Gamepad human
    class Bridge,Teleop voice
    class Power ext
    class Objectives,State data
    class Commander brain
    class Motors,Camera,Freezer robot

    style Inputs fill:#f43f5e12,stroke:#f43f5e,stroke-width:1.5px,stroke-dasharray:6 5,color:#e11d48
    style Container fill:#64748b12,stroke:#64748b,stroke-width:1.5px,stroke-dasharray:6 5,color:#64748b

    linkStyle 0,1 stroke:#f43f5e,stroke-width:3px
    linkStyle 2,3,4,5 stroke:#14b8a6,stroke-width:2px
    linkStyle 6,7,10,11,12 stroke:#8b5cf6,stroke-width:2px
    linkStyle 8 stroke:#3b82f6,stroke-width:2px
    linkStyle 9 stroke:#14b8a6,stroke-width:2px
