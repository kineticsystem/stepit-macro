# Interactive shell setup for the developer user of the stepit-macro container,
# sourced from ~/.bashrc. Variables are set with ENV in the Dockerfile instead.

source /opt/ros/jazzy/setup.bash

# The three workspaces, in the order they are built: the modules, the rig's
# plugin on top of them, and the rig's own programs.
for workspace in modules plugins stepit-macro; do
    if [ -f ~/ws/install/$workspace/setup.bash ]; then
        source ~/ws/install/$workspace/setup.bash
    fi
done

# Short names for the scripts in bin, which are on the PATH: the whole rig.
# Aliases rather than symlinks: `test` is a bash builtin, which wins over a PATH
# lookup.
alias build='build.sh'
alias test='test.sh'
alias update='update.sh'
# The editor's validator, on the rig's objectives.
alias validate='~/ws/modules/stepit-editor/bin/validate.sh'
