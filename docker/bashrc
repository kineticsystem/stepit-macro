# Interactive shell setup for the developer user of the stepit-macro container,
# sourced from ~/.bashrc. Variables are set with ENV in the Dockerfile instead.

source /opt/ros/jazzy/setup.bash
if [ -f ~/ws/install/stepit-macro/setup.bash ]; then
    source ~/ws/install/stepit-macro/setup.bash
fi

# Short names for the scripts in bin/stepit-macro, which are on the PATH. Aliases
# rather than symlinks: `test` is a bash builtin, which wins over a PATH lookup.
alias build='build.sh'
alias test='test.sh'
alias update='update.sh'
