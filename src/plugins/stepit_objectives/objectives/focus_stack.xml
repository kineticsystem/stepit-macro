<?xml version="1.0" encoding="UTF-8"?>
<!--
  Objective: FocusStack

  Shoots a focus stack at each of several angles of the rotary stage: at each
  angle, the rail steps the camera from the near end to the far end, marked
  with MarkNear and MarkFar, and a shot is taken at every step. With 10 shots
  and 35 angles, that is 350 pictures.

    ros2 action send_goal /commander/execute_objective \
      btcpp_ros2_interfaces/action/ExecuteTree \
      "{target_tree: FocusStack, payload: '{shots: 10, stage_from: -17, stage_to: 17, angles: 35}'}"

  The angles are in degrees of the stage, from where it is when the stack
  starts: deg_per_turn.joint1, in the commander's section of rig.yaml, turns
  them into radians of its motor. When the stack is done, every joint goes
  back to where it started.

  Backlash: every move approaches its position going from the first position
  of the stack to the last, the rail from near to far and the stage from
  stage_from to stage_to. A joint that would arrive the other way, e.g. the
  rail coming back to the near end for the next angle, first goes past by its
  overshoot, set per joint in the commander's section of rig.yaml.

  A shot whose picture does not come is fired again once; then the stack
  stops, rather than leave a gap.

  How far it is, the pictures taken of how many, goes on the latched topic
  /focus_stack/progress, for every page to show, whichever started it.

  The pictures of a stack go into a folder of their own under the camera's
  pictures folder, named after when it started, with one folder per angle:
  2026-10-06_15-20-04/angle_01_-17.0deg, angle_02_-16.0deg, and so on.
-->
<root BTCPP_format="4" main_tree_to_execute="FocusStack">

  <BehaviorTree ID="FocusStack" _description="Shoots a focus stack, from the near mark to the far one, at each of several angles of the rotary stage.">
    <Sequence>
      <SubTree ID="EnsureControllers" controllers="position_controller"/>
      <GetJointPositions _description="Where every joint starts: the angles are from here, and the joints come back here."
                         topic_name="/joint_states" joint_names="joint1;joint2;joint3;joint4;joint5" positions="{home}"/>
      <LoadValues _description="The near end of the rail, from MarkNear." key="near" values="{near}"/>
      <LoadValues _description="The far end of the rail, from MarkFar." key="far" values="{far}"/>
      <CurrentTime _description="The name of the stack's folder of pictures: when it started." time="{stack_folder}"/>
      <!-- How far the stack is, for every page: none of its pictures yet. -->
      <Script code="pictures_total := @shots * @angles"/>
      <ReportProgress _description="No picture of the stack yet." done="0" total="{pictures_total}"/>
      <DegreesToRadians _description="The first angle, in radians of the stage's motor." joint="joint1"
                        degrees="{@stage_from}" radians="{first_angle}"/>
      <DegreesToRadians _description="The last angle, in radians of the stage's motor." joint="joint1"
                        degrees="{@stage_to}" radians="{last_angle}"/>

      <!-- The first and the last position of the stack: every move approaches
           its position going from the one toward the other. -->
      <SetJoints _description="The stage at its first angle." input="{home}" joint_names="joint1;joint2;joint3;joint4;joint5"
                 joints="joint1" values="{first_angle}" relative="true" output="{first}"/>
      <SetJoints _description="The first position: the rail at the near end." input="{first}" joint_names="joint1;joint2;joint3;joint4;joint5"
                 joints="joint2" values="{near}" output="{first}"/>
      <SetJoints _description="The stage at its last angle." input="{home}" joint_names="joint1;joint2;joint3;joint4;joint5"
                 joints="joint1" values="{last_angle}" relative="true" output="{last}"/>
      <SetJoints _description="The last position: the rail at the far end." input="{last}" joint_names="joint1;joint2;joint3;joint4;joint5"
                 joints="joint2" values="{far}" output="{last}"/>

      <!-- To the start of the stack. The rail may have been driven to the near
           mark either way: it goes past it, and back, whatever. -->
      <CommandJointPositions _description="Moves to the first position, past it and back."
                             topic_name="/position_controller/commands"
                             controller_joints="joint1;joint2;joint3;joint4;joint5"
                             joint_names="joint1;joint2;joint3;joint4;joint5" positions="{first}"
                             approach_from="{first}" approach_to="{last}" overshoot_in_place="true"/>

      <Steps _description="The angles of the stage, in degrees." start="{@stage_from}" end="{@stage_to}" count="{@angles}" value="{angle_degrees}" index="{angle_index}">
        <Sequence>
          <DegreesToRadians _description="This angle, in radians of the stage's motor." joint="joint1"
                            degrees="{angle_degrees}" radians="{angle}"/>
          <SetJoints _description="Every joint where it started, the stage at this angle." input="{home}" joint_names="joint1;joint2;joint3;joint4;joint5"
                     joints="joint1" values="{angle}" relative="true" output="{pose}"/>
          <!-- One folder of pictures per angle, inside the stack's: the
               pictures of one rail's stack, to be stacked together. -->
          <SetPictureFolder _description="The pictures of this angle go into a folder of their own."
                            folder="{stack_folder}" index="{angle_index}" degrees="{angle_degrees}"/>
          <Steps _description="The shots of the rail, from the near end to the far one." start="{near}" end="{far}" count="{@shots}" value="{rail}" index="{shot}">
            <Sequence>
              <SetJoints _description="The rail at this shot." input="{pose}" joint_names="joint1;joint2;joint3;joint4;joint5"
                         joints="joint2" values="{rail}" output="{target}"/>
              <CommandJointPositions _description="Moves there, approaching from the start of the stack."
                                     topic_name="/position_controller/commands"
                                     controller_joints="joint1;joint2;joint3;joint4;joint5"
                                     joint_names="joint1;joint2;joint3;joint4;joint5" positions="{target}"
                                     approach_from="{first}" approach_to="{last}"/>
              <!-- Let the vibrations of the move die down. To be measured. -->
              <Sleep msec="500"/>
              <RetryUntilSuccessful num_attempts="2">
                <ExpectPicture _description="Fails if the camera reports no picture of the shot.">
                  <Shoot _description="Fires the default sequence of the Freezer: the camera and the lights."/>
                </ExpectPicture>
              </RetryUntilSuccessful>
              <Script code="pictures_done := angle_index * @shots + shot + 1"/>
              <ReportProgress _description="One more picture of the stack." done="{pictures_done}" total="{pictures_total}"/>
            </Sequence>
          </Steps>
        </Sequence>
      </Steps>

      <SetPictureFolder _description="The next pictures go into the pictures folder itself again." folder=""/>
      <CommandJointPositions _description="Every joint back to where it started."
                             topic_name="/position_controller/commands"
                             controller_joints="joint1;joint2;joint3;joint4;joint5"
                             joint_names="joint1;joint2;joint3;joint4;joint5" positions="{home}"/>
    </Sequence>
  </BehaviorTree>

  <!-- The payload of the objective, for editors: what each entry is, with an example. -->
  <TreeNodesModel>
    <SubTree ID="FocusStack">
      <input_port name="shots">how many shots from the near end of the rail to the far one, both included, e.g. 10</input_port>
      <input_port name="stage_from">the first angle of the stage, in degrees, from where it is, e.g. -17</input_port>
      <input_port name="stage_to">the last angle of the stage, in degrees, from where it is, e.g. 17</input_port>
      <input_port name="angles">how many angles from the first to the last, both included, e.g. 35</input_port>
    </SubTree>
  </TreeNodesModel>

</root>
