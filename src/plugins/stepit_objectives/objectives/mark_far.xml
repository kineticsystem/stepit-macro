<?xml version="1.0" encoding="UTF-8"?>
<!--
  Objective: MarkFar

  Remembers where the rail is as the far end of a focus stack: the user
  drives the camera there, with the gamepad or the sliders, until the
  farthest part of the subject that must be sharp is in focus, and runs
  this. FocusStack shoots from the near end to the far one.

    ros2 action send_goal /commander/execute_objective \
      btcpp_ros2_interfaces/action/ExecuteTree \
      "{target_tree: MarkFar, payload: ''}"

  The position is saved as "far" in the state of the rig, the parameter
  state.far of the node stack_state, which every page shows. It is a count of
  motor steps since the controller powered up: it means nothing after the
  controller restarts, so stack_state forgets it at every start of the rig,
  and both ends are marked again for every subject.

  It reads the joint states only: it moves nothing, and does not switch the
  controllers, so the gamepad keeps driving the robot.
-->
<root BTCPP_format="4" main_tree_to_execute="MarkFar">

  <BehaviorTree ID="MarkFar" _description="Remembers where the rail is as the far end of a focus stack.">
    <Sequence>
      <GetJointPositions _description="Where the rail is." topic_name="/joint_states" joint_names="joint2" positions="{rail}"/>
      <SaveValues _description="Saves it as the far end." key="far" values="{rail}"/>
    </Sequence>
  </BehaviorTree>

  <!-- The payload of the objective, for editors: it takes none. -->
  <TreeNodesModel>
    <SubTree ID="MarkFar"/>
  </TreeNodesModel>

</root>
