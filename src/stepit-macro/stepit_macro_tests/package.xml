<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stepit_macro_tests</name>
  <version>0.1.0</version>
  <description>
    Tests of the packages that run in the stepit-macro container: the gamepad
    teleoperation, against a fake commander, and the configuration of the rig.
  </description>
  <maintainer email="lentigrams@gmail.com">developer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>btcpp_ros2_interfaces</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>rclcpp</test_depend>
  <test_depend>rclcpp_action</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>stepit_bringup</test_depend>
  <test_depend>stepit_teleop</test_depend>
  <test_depend>stepit_power</test_depend>
  <test_depend>stepit_state</test_depend>
  <test_depend>std_srvs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
